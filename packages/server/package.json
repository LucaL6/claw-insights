{
  "name": "@claw-insights/server",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx --watch src/index.ts",
    "build": "tsup --config tsup.config.ts && sed -i '' 's/from \"sqlite\"/from \"node:sqlite\"/g' dist/*.js dist/**/*.js 2>/dev/null || true && cp src/schema/schema.graphql dist/schema.graphql",
    "lint": "eslint src/",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@resvg/resvg-js": "^2.6.2",
    "cookie": "^0.7.2",
    "express": "^5.0.0",
    "graphql": "^16.9.0",
    "graphql-yoga": "^5.10.0",
    "pino": "^10.3.1",
    "satori": "^0.19.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/cookie": "^0.6.0",
    "@types/express": "^5.0.0",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.0.18",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "tsup": "^8.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  },
  "version": "0.1.0",
  "description": "Claw Insights server — GraphQL API, data pipeline, screenshot renderer",
  "author": "Luca Liao",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LucaL6/claw-insights.git"
  },
  "bugs": {
    "url": "https://github.com/LucaL6/claw-insights/issues"
  },
  "homepage": "https://github.com/LucaL6/claw-insights#readme",
  "keywords": [
    "openclaw",
    "graphql",
    "api",
    "monitoring",
    "sqlite"
  ]
}
