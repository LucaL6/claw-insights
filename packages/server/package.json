{
  "name": "@claw-insights/server",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx --watch src/index.ts",
    "build": "tsup --config tsup.config.ts && node scripts/normalize-sqlite-imports.mjs && cp src/schema/schema.graphql dist/schema.graphql",
    "lint": "eslint src/",
    "verify:spawnedby": "node scripts/verify-openclaw-spawnedby.mjs",
    "check:session-hierarchy": "node scripts/check-session-hierarchy-parity.mjs",
    "audit:spawnedby-gaps": "node scripts/audit-spawnedby-gaps.mjs",
    "backfill:spawnedby": "node scripts/backfill-spawnedby-from-logs.mjs",
    "apply:backfill": "node scripts/apply-backfill.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:integration": "RUN_INTEGRATION=1 MOCK_SCENARIO=healthy CLAW_INSIGHTS_CLI=../../sandbox/mock-openclaw/bin/openclaw CLAW_INSIGHTS_SESSIONS_PATH=../../sandbox/fixtures/sessions.json CLAW_INSIGHTS_SERVER_PORT=4000 vitest run src/__tests__/resolvers.test.ts src/__tests__/graphql-integration.test.ts src/__tests__/data-flow-integration.test.ts src/__tests__/snapshot-integration.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@resvg/resvg-js": "^2.6.2",
    "cookie": "^0.7.2",
    "express": "^5.0.0",
    "graphql": "^16.9.0",
    "graphql-yoga": "^5.10.0",
    "lru-cache": "^5.1.1",
    "pino": "^10.3.1",
    "satori": "^0.19.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/cookie": "^0.6.0",
    "@types/express": "^5.0.0",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.0.18",
    "glob": "^13.0.6",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "tsup": "^8.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  },
  "version": "0.1.0",
  "description": "Claw Insights server — GraphQL API, data pipeline, screenshot renderer",
  "author": "Luca Liao",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LucaL6/claw-insights.git"
  },
  "bugs": {
    "url": "https://github.com/LucaL6/claw-insights/issues"
  },
  "homepage": "https://github.com/LucaL6/claw-insights#readme",
  "keywords": [
    "openclaw",
    "graphql",
    "api",
    "monitoring",
    "sqlite"
  ]
}
