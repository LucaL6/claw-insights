{
  "name": "claw-insights",
  "version": "0.1.5",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "bin": {
    "claw-insights": "./bin/claw-insights.mjs"
  },
  "scripts": {
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:check": "graphql-codegen --config codegen.ts --check",
    "codegen:verify": "node scripts/check-codegen-sync.mjs",
    "codegen:assert-clean": "node scripts/check-codegen-sync.mjs --assert-clean",
    "codegen:watch": "graphql-codegen --config codegen.ts --watch",
    "dev": "npm run codegen && concurrently -n codegen,server,web \"npm run codegen:watch\" \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "npm run -w @claw-insights/server dev",
    "dev:web": "npm run -w @claw-insights/web dev",
    "test": "npm run --workspaces test && npm run test:scripts",
    "test:server": "npm run -w @claw-insights/server test",
    "test:web": "npm run -w @claw-insights/web test",
    "test:scripts": "node --test scripts/__tests__/check-codegen-sync.test.mjs scripts/__tests__/check-cli-runtime-policy-parity.test.mjs scripts/__tests__/check-release-tarball-assets.test.mjs",
    "test:coverage": "npm run -w @claw-insights/server test -- --coverage && npm run -w @claw-insights/web test -- --coverage",
    "test:integration": "npm run -w @claw-insights/server test:integration",
    "test:e2e": "npm run -w @claw-insights/web test:e2e",
    "prepare": "husky",
    "build": "npm run codegen && npm run --workspaces build",
    "start": "npm run build && node bin/claw-insights.mjs start",
    "local": "npm run build && node bin/claw-insights.mjs start --no-auth",
    "stop": "node bin/claw-insights.mjs stop",
    "status": "node bin/claw-insights.mjs status",
    "logs": "node bin/claw-insights.mjs logs",
    "restart": "npm run build && node bin/claw-insights.mjs restart",
    "check:assets": "node scripts/check-assets-parity.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:all": "npm run test && npm run test:integration && npm run test:e2e"
  },
  "lint-staged": {
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@graphql-codegen/cli": "^6.1.1",
    "@graphql-codegen/client-preset": "^5.2.2",
    "@graphql-codegen/typescript": "^5.0.7",
    "@graphql-codegen/typescript-resolvers": "^5.1.5",
    "@graphql-typed-document-node/core": "^3.2.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript-eslint": "^8.48.0"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "description": "Real-time monitoring dashboard for OpenClaw gateway",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LucaL6/claw-insights.git"
  },
  "homepage": "https://github.com/LucaL6/claw-insights#readme",
  "bugs": {
    "url": "https://github.com/LucaL6/claw-insights/issues"
  },
  "keywords": [
    "openclaw",
    "dashboard",
    "monitoring",
    "analytics",
    "ai-agent"
  ],
  "author": "Luca Liao",
  "files": [
    "bin/",
    "packages/server/dist/",
    "packages/web/dist/",
    "packages/shared/src/",
    "LICENSE",
    "README.md"
  ]
}
