{
  "name": "claw-insights",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "bin": {
    "claw-insights": "./bin/claw-insights.mjs"
  },
  "scripts": {
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:watch": "graphql-codegen --config codegen.ts --watch",
    "dev": "npm run codegen && concurrently -n codegen,server,web \"npm run codegen:watch\" \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "npm run -w @claw-insights/server dev",
    "dev:web": "npm run -w @claw-insights/web dev",
    "test": "npm run --workspaces test",
    "test:server": "npm run -w @claw-insights/server test",
    "test:web": "npm run -w @claw-insights/web test",
    "test:coverage": "npm run -w @claw-insights/server test -- --coverage && npm run -w @claw-insights/web test -- --coverage",
    "test:e2e": "npx playwright test --config packages/web/e2e/playwright.config.ts",
    "prepare": "husky",
    "build": "npm run codegen && npm run --workspaces build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix --no-warn-ignored"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^6.1.1",
    "@graphql-codegen/client-preset": "^5.2.2",
    "@graphql-codegen/typescript": "^5.0.7",
    "@graphql-codegen/typescript-resolvers": "^5.1.5",
    "@graphql-typed-document-node/core": "^3.2.0",
    "concurrently": "^9.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "description": "Real-time monitoring dashboard for OpenClaw gateway",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LucaL6/claw-insights.git"
  },
  "homepage": "https://github.com/LucaL6/claw-insights#readme",
  "bugs": {
    "url": "https://github.com/LucaL6/claw-insights/issues"
  },
  "keywords": [
    "openclaw",
    "dashboard",
    "monitoring",
    "analytics",
    "ai-agent"
  ],
  "author": "Claw Insights Contributors"
}
