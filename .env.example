# Claw Insights environment variables
# Copy to .env and customize

# API authentication token (minimum 32 characters)
# CLAW_INSIGHTS_API_TOKEN=your-secret-token-here-minimum-32-chars

# Server port (default: 4000)
# CLAW_INSIGHTS_SERVER_PORT=4000

# Web UI port (default: 3200)
# CLAW_INSIGHTS_WEB_PORT=3200

# OpenClaw gateway URL (default: http://localhost:3000)
# CLAW_INSIGHTS_GATEWAY=http://localhost:3000

# Log directory (default: ~/.config/openclaw/logs)
# CLAW_INSIGHTS_LOG_DIR=

# Disable authentication (NOT recommended for production)
# CLAW_INSIGHTS_NO_AUTH=false
