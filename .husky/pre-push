#!/usr/bin/env bash
set -euo pipefail
trap 'echo "❌ Pre-push checks failed. Push blocked."' ERR

# ── Mirror CI: lint job ──
echo "🔍 ESLint (server)..."
npm run -w @claw-insights/server lint

echo "🔍 ESLint (web)..."
npm run -w @claw-insights/web lint

echo "🔍 Type Check (server)..."
npm run -w @claw-insights/server typecheck

# ── Mirror CI: test job ──
echo "🔨 Build (codegen + all workspaces)..."
npm run build

echo "🧪 Unit Tests with Coverage (server)..."
npm run -w @claw-insights/server test -- --coverage

echo "🧪 Unit Tests with Coverage (web)..."
npm run -w @claw-insights/web test -- --coverage

echo "✅ All checks passed."
