#!/usr/bin/env bash
set -euo pipefail
trap 'echo "❌ Checks failed. Push blocked."' ERR

echo "🔍 Running ESLint..."
npm run -w @claw-insights/server lint
npm run -w @claw-insights/web lint

echo "🧪 Running tests with coverage..."
npm run -w @claw-insights/server test -- --coverage
npm run -w @claw-insights/web test -- --coverage

echo "✅ All checks passed."
